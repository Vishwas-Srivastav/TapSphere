#!/usr/bin/env bash
# ==============================================================================
# Git Hook: pre-push
# Validates branch naming format before pushing to remote repository.
# ==============================================================================

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Allow default/baseline branch pushes
if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "development" || "$CURRENT_BRANCH" == "develop" ]]; then
  exit 0
fi

# Allow automated bot branches
if [[ "$CURRENT_BRANCH" =~ ^(dependabot|renovate)/ ]]; then
  exit 0
fi

# Validate branch format: <PROJECT_INITIALS>-<NUMBER> (e.g. WSAI-01, UC-01, ML-01) or optional prefix (feature/WSAI-01)
BRANCH_REGEX="^((feature|bugfix|chore)/)?[a-zA-Z0-9]+-[0-9]+$"

if [[ ! "$CURRENT_BRANCH" =~ $BRANCH_REGEX ]]; then
  echo ""
  echo -e "\033[0;31m[GUARDRAIL ERROR]\033[0m Current branch '$CURRENT_BRANCH' violates branch naming standards."
  echo ""
  echo "Expected format: <PROJECT_INITIALS>-<NUMBER> (or (feature|bugfix|chore)/<PROJECT_INITIALS>-<NUMBER>)"
  echo "Examples:"
  echo "  WSAI-01 (WebscribeAI)"
  echo "  UC-01   (Unclutter)"
  echo "  ML-01   (Memory Lens)"
  echo ""
  echo "Rename your current branch with:"
  echo "  git branch -m <valid-branch-name>"
  echo ""
  exit 1
fi

# Validate that branch is cut from and has history with 'development'
BASE_REF=""
if git rev-parse --verify "origin/development" >/dev/null 2>&1; then
  BASE_REF="origin/development"
elif git rev-parse --verify "development" >/dev/null 2>&1; then
  BASE_REF="development"
fi

if [[ -n "$BASE_REF" ]]; then
  MERGE_BASE=$(git merge-base "$BASE_REF" HEAD 2>/dev/null || echo "")
  if [[ -z "$MERGE_BASE" ]]; then
    echo ""
    echo -e "\033[0;31m[GUARDRAIL ERROR]\033[0m Branch '$CURRENT_BRANCH' has no shared commit history with '$BASE_REF'."
    echo "Rule: All branches must be cut from the 'development' branch."
    echo ""
    exit 1
  fi
fi

exit 0
