# ==============================================================================
# Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit real credentials, API keys, tokens, or passwords to git.
# - Keep local '.env' values outside version control.
# ==============================================================================

# Application Runtime Settings
NODE_ENV=development
APP_PORT=3000
APP_HOST=localhost

# Logging & Debugging
LOG_LEVEL=info

# Service / API Configuration (Placeholders)
API_BASE_URL=https://api.example.com/v1
API_TIMEOUT_MS=5000

# Secret Key Placeholders (Populate locally in .env only; do not commit actual values)
# API_SECRET_KEY=your-local-dev-secret-key
# DATABASE_URL=postgresql://user:password@localhost:5432/<PROJECT_NAME>_dev
