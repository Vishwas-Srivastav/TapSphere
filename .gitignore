# ==============================================================================
# Git Ignore - Lightweight Engineering Template
# ==============================================================================

# Environment and Secret Files
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Dependency Directories
node_modules/
vendor/
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pnpm-store/

# Build and Distribution Outputs
dist/
build/
out/
bin/
*.exe
*.dll
*.so
*.dylib
.next/
.nuxt/
.cache/

# Testing and Coverage Reports
coverage/
.nyc_output/
.pytest_cache/
*.lcov
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary Files
*.tmp
*.temp
.tmp/
